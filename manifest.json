{
	"name": "JsonEditor",
	"version": "1.0.0",
	"manifest_version": 3,
	"description": "A simple JSON editor based on jsoneditor.",
	"action": {
		"default_title": "JsonEditor",
		"default_popup": "index.html"
	},
	"icons": {
		"128": "resources/icon.png"
	},
	"permissions": [
		"clipboardRead"
	],
	"host_permissions": [
		"https://api.deepseek.com/*"
	]
}
